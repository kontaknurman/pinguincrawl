<%
  const _nav = typeof nav !== 'undefined' && nav ? nav : {};
  const _p = typeof page !== 'undefined' ? page : '';
  const _active = (names) => (names.includes(_p) ? 'active' : '');
  const _current = (names) => (names.includes(_p) ? 'aria-current="page"' : '');
%>
<aside class="offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
  <div class="offcanvas-header border-bottom">
    <span class="offcanvas-title fw-semibold" id="sidebarLabel"><i class="bi bi-bug-fill text-primary"></i> CrawlKomik</span>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Tutup menu"></button>
  </div>
  <div class="offcanvas-body">
    <div class="sidebar-inner">
      <a href="/admin" class="sidebar-brand d-none d-lg-flex"><i class="bi bi-bug-fill text-primary"></i> CrawlKomik</a>

      <ul class="nav flex-column sidebar-nav gap-1">
        <li class="nav-item">
          <a class="nav-link <%= _active(['dashboard', 'website-edit', 'config']) %>" href="/admin" <%- _current(['dashboard']) %>>
            <i class="bi bi-speedometer2"></i> Dashboard
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= _active(['websites']) %>" href="/admin/websites/new" <%- _current(['websites']) %>>
            <i class="bi bi-plus-circle"></i> Add Website
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= _active(['captcha']) %>" href="/admin/captcha" <%- _current(['captcha']) %>>
            <i class="bi bi-shield-lock"></i> CAPTCHA Sessions
            <% if (_nav.captchaWaiting) { %><span class="badge rounded-pill text-bg-warning" title="Menunggu manual solve"><%= _nav.captchaWaiting %></span><% } %>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= _active(['logs']) %>" href="/admin/logs" <%- _current(['logs']) %>>
            <i class="bi bi-journal-text"></i> API Logs
          </a>
        </li>
      </ul>

      <div class="sidebar-section">System</div>
      <ul class="nav flex-column sidebar-nav gap-1">
        <li class="nav-item">
          <a class="nav-link <%= _active(['storage']) %>" href="/admin/storage" <%- _current(['storage']) %>>
            <i class="bi bi-hdd"></i> Storage
            <% if (_nav.diskWarning) { %><span class="badge rounded-pill text-bg-danger" title="Disk hampir penuh">!</span><% } %>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= _active(['settings']) %>" href="/admin/settings" <%- _current(['settings']) %>>
            <i class="bi bi-gear"></i> Settings
          </a>
        </li>
      </ul>

      <details class="mt-3 px-2 endpoint-list">
        <summary class="small text-body-secondary">API Endpoints</summary>
        <ul class="list-unstyled small mt-2 mb-0 d-grid gap-1">
          <li><code>/api/katalog</code></li>
          <li><code>/api/komik</code></li>
          <li><code>/api/chapters</code></li>
          <li><code>/api/chapter</code></li>
          <li><code>/api/custom/:type</code></li>
          <li><code>/api/image/:hash</code></li>
        </ul>
      </details>

      <div class="sidebar-footer">
        <div class="d-grid gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-theme-toggle>
            <i data-theme-icon class="bi bi-sun"></i> <span data-theme-label>Light mode</span>
          </button>
          <a href="/admin/logout" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-left me-1"></i>Logout</a>
        </div>
        <small class="text-body-secondary d-block text-center mt-2">Created by Nurman</small>
      </div>
    </div>
  </div>
</aside>
