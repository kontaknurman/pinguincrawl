<div class="auth-card">
  <div class="text-center mb-4">
    <div class="auth-brand"><i class="bi bi-bug-fill text-primary"></i> CrawlKomik</div>
    <div class="text-body-secondary small">Admin panel</div>
  </div>
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h1 class="h5 mb-3">Login</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-octagon me-1"></i><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <div class="input-group">
            <input type="password" class="form-control" id="password" name="password" required autofocus autocomplete="current-password">
            <button class="btn btn-outline-secondary" type="button" data-toggle-password="#password" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i>Login</button>
      </form>

      <% if (typeof isDefault !== 'undefined' && isDefault) { %>
        <div class="alert alert-warning mt-3 py-2 mb-0 small">
          Default password: <code>admin</code> — ganti setelah login (Settings → Keamanan).
        </div>
      <% } %>
    </div>
  </div>
</div>
