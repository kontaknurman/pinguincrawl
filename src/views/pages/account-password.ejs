<div class="auth-card">
  <div class="text-center mb-4">
    <div class="auth-brand"><i class="bi bi-bug-fill text-primary"></i> PinguinCrawl</div>
    <div class="text-body-secondary small">Admin panel</div>
  </div>
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h1 class="h5 mb-2">Buat password baru</h1>
      <p class="text-body-secondary small">Halo <strong><%= username %></strong> — password yang kamu pakai untuk login tadi adalah password default atau sementara. Buat password baru untuk melanjutkan.</p>

      <% if (error) { %>
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-octagon me-1"></i><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/change-password">
        <!-- Lets password managers store the new password under the right username -->
        <input type="text" name="username" value="<%= username %>" autocomplete="username" hidden>
        <div class="mb-3">
          <label class="form-label" for="current_password">Password saat ini</label>
          <input type="password" class="form-control" id="current_password" name="current_password" required autofocus autocomplete="current-password">
        </div>
        <div class="mb-3">
          <label class="form-label" for="new_password">Password baru</label>
          <div class="input-group">
            <input type="password" class="form-control" id="new_password" name="new_password" required minlength="<%= minPassword %>" maxlength="200" autocomplete="new-password">
            <button class="btn btn-outline-secondary" type="button" data-toggle-password="#new_password" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button>
          </div>
          <small class="form-hint">Minimal <%= minPassword %> karakter, tidak sama dengan username.</small>
        </div>
        <div class="mb-3">
          <label class="form-label" for="confirm_password">Ulangi password baru</label>
          <input type="password" class="form-control" id="confirm_password" name="confirm_password" required minlength="<%= minPassword %>" maxlength="200" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg me-1"></i>Save Password</button>
      </form>

      <div class="text-center mt-3">
        <a href="/admin/logout" class="text-body-secondary small"><i class="bi bi-box-arrow-left me-1"></i>Logout</a>
      </div>
    </div>
  </div>
</div>
