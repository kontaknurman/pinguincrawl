<%
  const isEdit = !!(website && website.id);
  const w = website || {};
  const method = w.image_cache_method || 'browser';
  const defaultTypes = ['katalog', 'komik_detail', 'chapter_list', 'chapter'];
  const cpts = typeof customPageTypes !== 'undefined' && customPageTypes ? customPageTypes : [];
  const endpointFor = (pt) => ({ katalog: '/api/katalog', komik_detail: '/api/komik', chapter_list: '/api/chapters', chapter: '/api/chapter' }[pt] || '/api/custom/' + pt);
  const _error = typeof error !== 'undefined' ? error : null;
  const _cptError = typeof cpt_error !== 'undefined' ? cpt_error : null;
  const _backupError = typeof backup_error !== 'undefined' ? backup_error : null;
  const _restoreError = typeof restore_error !== 'undefined' ? restore_error : null;
  const _restoreName = typeof restoreName !== 'undefined' ? restoreName : '';
  let cookieInfo = null;
  try {
    const list = JSON.parse(w.cookies || '[]');
    if (Array.isArray(list)) cookieInfo = { count: list.length, cf: list.some(c => c && c.name === 'cf_clearance') };
  } catch (e) { /* shown as invalid by the JSON check */ }
  const timezones = ['Asia/Jakarta', 'Asia/Makassar', 'Asia/Jayapura', 'Asia/Singapore', 'Asia/Kuala_Lumpur', 'Asia/Bangkok', 'Asia/Ho_Chi_Minh', 'Asia/Manila', 'Asia/Hong_Kong', 'Asia/Taipei', 'Asia/Tokyo', 'Asia/Seoul', 'Asia/Shanghai', 'Asia/Kolkata', 'Asia/Dubai', 'Europe/London', 'Europe/Amsterdam', 'Europe/Berlin', 'Europe/Paris', 'America/New_York', 'America/Chicago', 'America/Los_Angeles', 'Australia/Sydney', 'UTC'];
%>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb small">
    <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= isEdit ? w.name : 'Add Website' %></li>
  </ol>
</nav>

<div class="page-header">
  <div>
    <h1><%= isEdit ? w.name : 'Add Website' %></h1>
    <p class="page-subtitle"><%= isEdit ? 'Pengaturan website, page config, dan custom page type.' : 'Daftarkan website baru, lalu atur selector untuk tiap page type.' %></p>
  </div>
  <% if (isEdit) { %>
  <div class="page-actions">
    <a href="#page-configs" class="btn btn-outline-primary"><i class="bi bi-sliders me-1"></i>Page configs</a>
    <a href="#backup" class="btn btn-outline-secondary"><i class="bi bi-database me-1"></i>Backup</a>
  </div>
  <% } else { %>
  <div class="page-actions">
    <a href="#restore" class="btn btn-outline-secondary"><i class="bi bi-upload me-1"></i>Restore dari backup</a>
  </div>
  <% } %>
</div>

<% if (_error) { %>
  <div class="alert alert-danger"><i class="bi bi-exclamation-octagon me-1"></i><%= _error %></div>
<% } %>

<form method="POST" action="<%= isEdit ? '/admin/websites/' + w.id : '/admin/websites' %>" data-dirty-guard>
  <div class="row g-4">
    <div class="col-xl-6">
      <section class="card h-100">
        <div class="card-header"><h2 class="section-title"><i class="bi bi-info-circle me-1"></i>Informasi dasar</h2></div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="name">Name <span class="text-danger">*</span></label>
            <input type="text" id="name" name="name" class="form-control font-monospace" value="<%= w.name || '' %>" required placeholder="mis. mywebsite" autocapitalize="none" spellcheck="false">
            <small class="form-hint">Slug unik, dipakai di API: <code>?website=<%= w.name || 'mywebsite' %></code>. Otomatis huruf kecil.</small>
          </div>
          <div class="mb-3">
            <label class="form-label" for="base_url">Base URL <span class="text-danger">*</span></label>
            <input type="url" id="base_url" name="base_url" class="form-control" value="<%= w.base_url || '' %>" required placeholder="https://example.com" inputmode="url">
          </div>
          <% if (isEdit) { %>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" name="active" id="active" <%= w.active ? 'checked' : '' %>>
            <label class="form-check-label" for="active">Active</label>
          </div>
          <% } %>
        </div>
      </section>
    </div>

    <div class="col-xl-6">
      <section class="card h-100">
        <div class="card-header"><h2 class="section-title"><i class="bi bi-shield-lock me-1"></i>Jaringan &amp; identitas browser</h2></div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="proxy">Proxy <small class="text-body-secondary">(opsional, satu per baris)</small></label>
            <textarea id="proxy" name="proxy" class="form-control font-monospace" rows="3" placeholder="http://user:pass@host:port&#10;socks5://user:pass@host:port&#10;host:port:user:pass" autocapitalize="none" spellcheck="false" autocomplete="off"><%= w.proxy || '' %></textarea>
            <small class="form-hint">Format: <code>http://user:pass@host:port</code>, <code>socks5://…</code>, <code>host:port</code> atau <code>host:port:user:pass</code>. Lebih dari satu baris = dirotasi; proxy yang gagal otomatis diganti proxy berikutnya dan diistirahatkan 5 menit.</small>
          </div>
          <div class="mb-3">
            <label class="form-label" for="proxy_rotation">Rotasi proxy</label>
            <select id="proxy_rotation" name="proxy_rotation" class="form-select">
              <% [['round_robin', 'Bergiliran — tiap crawl pakai proxy berikutnya'], ['random', 'Acak — tiap crawl pilih proxy secara acak'], ['failover', 'Cadangan — selalu proxy pertama, sisanya hanya saat itu gagal']].forEach(([val, label]) => { %>
                <option value="<%= val %>" <%= (w.proxy_rotation || 'round_robin') === val ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </div>
          <% if (isEdit && typeof proxyStatus !== 'undefined' && proxyStatus.length) { %>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
              <span class="form-label mb-0">Status proxy</span>
              <a class="small" href="/admin/browser-check?website=<%= encodeURIComponent(w.name) %>" target="_blank" rel="noopener"><i class="bi bi-activity me-1"></i>Cek semua proxy</a>
            </div>
            <ul class="list-group list-group-sm small">
              <% proxyStatus.forEach((s, i) => { %>
              <li class="list-group-item d-flex justify-content-between gap-2 py-1 px-2">
                <code class="text-break-all"><%= i + 1 %>. <%= s.display %></code>
                <span class="text-nowrap">
                  <% if (s.coolingDown) { %><span class="badge text-bg-danger" title="<%= s.error || '' %>">gagal · istirahat <%= Math.ceil(s.cooldownLeftMs / 60000) %> mnt</span>
                  <% } else if (s.okAt) { %><span class="badge text-bg-success">OK</span>
                  <% } else if (s.failedAt) { %><span class="badge text-bg-warning" title="<%= s.error || '' %>">pernah gagal</span>
                  <% } else { %><span class="badge text-bg-secondary">belum dipakai</span><% } %>
                </span>
              </li>
              <% }) %>
            </ul>
            <small class="form-hint">Status sejak server terakhir start. Cache gambar metode Browser ikut lewat proxy; metode Node.js HTTP, Lazy Proxy, dan mode HTTP biasa (JS off) tidak.</small>
          </div>
          <% } %>
          <div class="mb-3">
            <label class="form-label" for="user_agent">User Agent <small class="text-body-secondary">(opsional)</small></label>
            <input type="text" id="user_agent" name="user_agent" class="form-control font-monospace" value="<%= w.user_agent || '' %>" placeholder="Kosong = UA bawaan Lightpanda (disarankan)" spellcheck="false">
            <small class="form-hint">Lightpanda menolak UA yang mengandung <code>Mozilla</code> (tidak mau menyamar jadi browser lain) — UA seperti itu diabaikan dan request tetap mengaku Lightpanda. Mode HTTP biasa (JS off) memakai UA ini apa adanya.</small>
            <% if (w.user_agent && /mozilla/i.test(w.user_agent)) { %>
              <div class="alert alert-warning py-1 px-2 small mt-2 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>UA ini mengandung "Mozilla", jadi tidak dipakai saat JS rendering (Lightpanda).</div>
            <% } %>
          </div>
          <div>
            <label class="form-label" for="timezone">Timezone <small class="text-body-secondary">(opsional)</small></label>
            <input type="text" id="timezone" name="timezone" class="form-control" value="<%= w.timezone || '' %>" placeholder="Asia/Singapore" list="tzList" autocapitalize="none" spellcheck="false">
            <datalist id="tzList">
              <% timezones.forEach(tz => { %><option value="<%= tz %>"></option><% }) %>
            </datalist>
            <small class="form-hint">Jam browser (<code>Date</code>/<code>Intl</code>). Samakan dengan negara IP/proxy — container jalan di UTC, jadi tanpa ini tanggal yang dirender JavaScript situs memakai jam UTC.</small>
          </div>
        </div>
      </section>
    </div>

    <div class="col-12">
      <section class="card">
        <div class="card-header"><h2 class="section-title"><i class="bi bi-images me-1"></i>Image proxy / cache</h2></div>
        <div class="card-body">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" name="image_proxy" id="imageProxy" <%= w.image_proxy ? 'checked' : '' %>>
            <label class="form-check-label" for="imageProxy">Enable Image Proxy/Cache</label>
          </div>
          <small class="form-hint">Gambar disalurkan lewat server ini — untuk URL <code>blob:</code> atau gambar yang membatasi referrer. URL gambar di JSON API otomatis diganti URL proxy.</small>
          <div id="cacheMethodGroup" class="mt-3 <%= w.image_proxy ? '' : 'd-none' %>">
            <div class="form-label">Image cache method</div>
            <div class="row g-2">
              <% [
                ['browser', 'Browser', 'Diunduh oleh Lightpanda dari dalam halaman — lewat proxy, cookie & Referer yang sama dengan halaman.'],
                ['node', 'Node.js HTTP', 'Server mendownload terpisah dengan header Referer — langsung, tanpa proxy.'],
                ['proxy', 'Lazy Proxy', 'Di-cache saat gambar pertama kali diakses, bukan saat crawl — langsung, tanpa proxy.'],
              ].forEach(([val, title, desc]) => { %>
              <div class="col-md-4">
                <label class="option-card">
                  <input class="form-check-input" type="radio" name="image_cache_method" value="<%= val %>" <%= method === val ? 'checked' : '' %>>
                  <span><span class="fw-semibold d-block"><%= title %></span><span class="small text-body-secondary"><%= desc %></span></span>
                </label>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="col-12">
      <section class="card">
        <div class="card-header"><h2 class="section-title"><i class="bi bi-braces me-1"></i>Header, cookie &amp; localStorage <small class="text-body-secondary fw-normal">(opsional, JSON)</small></h2></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-lg-4">
              <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                <label class="form-label mb-0" for="custom_headers">Custom Headers</label>
                <span class="d-flex gap-2 align-items-center">
                  <span class="json-status badge" data-json-status-for="custom_headers"></span>
                  <button type="button" class="btn btn-sm btn-link p-0" data-json-format="custom_headers">Rapikan</button>
                </span>
              </div>
              <textarea name="custom_headers" id="custom_headers" class="form-control font-monospace" rows="6" data-json="object" spellcheck="false" placeholder='{"Referer": "https://example.com"}'><%= w.custom_headers || '{}' %></textarea>
              <small class="form-hint">Object JSON. Header <code>User-Agent</code> berisi <code>Mozilla</code> diabaikan Lightpanda.</small>
            </div>
            <div class="col-lg-4">
              <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                <label class="form-label mb-0" for="cookies">Cookies</label>
                <span class="d-flex gap-2 align-items-center">
                  <span class="json-status badge" data-json-status-for="cookies"></span>
                  <button type="button" class="btn btn-sm btn-link p-0" data-json-format="cookies">Rapikan</button>
                </span>
              </div>
              <textarea name="cookies" id="cookies" class="form-control font-monospace" rows="6" data-json="array" spellcheck="false" placeholder='[{"name":"key","value":"val","domain":".example.com"}]'><%= w.cookies || '[]' %></textarea>
              <small class="form-hint">
                Array JSON, dipasang sebelum halaman dibuka. Diperbarui otomatis kalau halaman challenge sempat lolos sendiri.
                <% if (cookieInfo && cookieInfo.count) { %><br><i class="bi bi-cookie"></i> <%= cookieInfo.count %> cookie tersimpan<%= cookieInfo.cf ? ' (termasuk cf_clearance)' : '' %>.<% } %>
              </small>
            </div>
            <div class="col-lg-4">
              <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                <label class="form-label mb-0" for="local_storage">LocalStorage</label>
                <span class="d-flex gap-2 align-items-center">
                  <span class="json-status badge" data-json-status-for="local_storage"></span>
                  <button type="button" class="btn btn-sm btn-link p-0" data-json-format="local_storage">Rapikan</button>
                </span>
              </div>
              <textarea name="local_storage" id="local_storage" class="form-control font-monospace" rows="6" data-json="object" spellcheck="false" placeholder='{"token": "abc123", "settings": "dark"}'><%= w.local_storage || '{}' %></textarea>
              <small class="form-hint">Object JSON key-value, di-inject sebelum halaman load.</small>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="sticky-actions">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i><%= isEdit ? 'Save' : 'Create Website' %></button>
    <a href="/admin" class="btn btn-outline-secondary">Cancel</a>
    <span class="dirty-note ms-auto"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Ada perubahan yang belum disimpan</span>
  </div>
</form>

<% if (!isEdit) { %>
<section class="card mt-4 mb-2" id="restore">
  <div class="card-header"><h2 class="section-title"><i class="bi bi-upload me-1"></i>Atau restore dari backup</h2></div>
  <div class="card-body">
    <% if (_restoreError) { %><div class="alert alert-danger py-2 small"><%= _restoreError %></div><% } %>
    <p class="small text-body-secondary">Upload file backup website (<em>Download Backup</em> di halaman website) — misalnya website yang terhapus, atau dari server PinguinCrawl lain. Website dibuat lengkap dengan page config dan custom page type-nya. Backup lengkap dari Settings juga bisa: isi nama website yang mau diambil.</p>
    <form method="POST" action="/admin/websites/restore" enctype="multipart/form-data" class="row g-2">
      <div class="col-md-6">
        <input type="file" class="form-control" name="dbfile" accept=".db,.sqlite,.sqlite3" required aria-label="File backup">
      </div>
      <div class="col-md-3">
        <input type="text" class="form-control font-monospace" name="website" value="<%= _restoreName %>" placeholder="nama (backup lengkap)" aria-label="Nama website di backup lengkap" autocapitalize="none" spellcheck="false">
      </div>
      <div class="col-md-3 d-grid">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-upload me-1"></i>Restore Website</button>
      </div>
    </form>
  </div>
</section>
<% } %>

<% if (isEdit) { %>
<section class="card mt-4" id="page-configs">
  <div class="card-header"><h2 class="section-title"><i class="bi bi-sliders me-1"></i>Page configs</h2></div>
  <div class="card-body">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
      <% pageTypes.forEach(pt => { const has = pageConfigs.find(c => c.page_type === pt); const isCustom = !defaultTypes.includes(pt); const exampleUrl = apiBase + endpointFor(pt) + '?website=' + w.name + '&url='; %>
      <div class="col">
        <div class="card h-100 website-item position-relative <%= isCustom ? 'border-info-subtle' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <a href="/admin/websites/<%= w.id %>/config/<%= pt %>" class="fw-semibold text-decoration-none stretched-link"><%= pt %></a>
              <% if (has) { %><span class="badge text-bg-success">Configured</span><% } else { %><span class="badge text-bg-secondary">Not set</span><% } %>
            </div>
            <div class="d-flex align-items-center gap-1 mt-2">
              <code class="small text-break-all"><%= endpointFor(pt) %></code>
              <button type="button" class="btn btn-sm btn-link p-0 ms-auto position-relative" style="z-index:2" data-copy="<%= exampleUrl %>" title="Copy URL API" aria-label="Copy URL API"><i class="bi bi-clipboard"></i></button>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <% if (isCustom) { %><span class="badge text-bg-info">Custom</span><% } else { %><span></span><% } %>
              <span class="small text-primary"><i class="bi bi-gear me-1"></i><%= has ? 'Edit' : 'Setup' %></span>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="card mt-4" id="page-types">
  <div class="card-header"><h2 class="section-title"><i class="bi bi-plus-square me-1"></i>Custom page types</h2></div>
  <div class="card-body">
    <% if (_cptError) { %><div class="alert alert-danger py-2"><%= _cptError %></div><% } %>
    <p class="small text-body-secondary">Tambah page type custom untuk website ini. Setiap custom type punya API endpoint <code>/api/custom/{name}</code>.</p>
    <form method="POST" action="/admin/websites/<%= w.id %>/custom-types" class="row g-2 mb-3">
      <div class="col-sm-4">
        <input type="text" class="form-control font-monospace" name="name" placeholder="name (slug)" pattern="[a-z0-9_]+" title="Huruf kecil, angka, underscore" required aria-label="Name" autocapitalize="none" spellcheck="false">
      </div>
      <div class="col-sm-5">
        <input type="text" class="form-control" name="label" placeholder="Label (nama tampilan)" required aria-label="Label">
      </div>
      <div class="col-sm-3 d-grid">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Add Type</button>
      </div>
    </form>
    <% if (cpts.length) { %>
    <table class="table table-sm align-middle table-stack mb-0">
      <thead><tr><th>Name</th><th>Label</th><th>API endpoint</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% cpts.forEach(ct => { %>
        <tr>
          <td data-label="Name"><code><%= ct.name %></code></td>
          <td data-label="Label"><%= ct.label %></td>
          <td data-label="Endpoint"><code class="text-break-all">/api/custom/<%= ct.name %></code></td>
          <td class="text-end td-actions text-nowrap">
            <a href="/admin/websites/<%= w.id %>/config/<%= ct.name %>" class="btn btn-sm btn-outline-info"><i class="bi bi-gear me-1"></i>Config</a>
            <form method="POST" action="/admin/websites/<%= w.id %>/custom-types/<%= ct.id %>/delete" class="d-inline" data-confirm="Delete custom type &quot;<%= ct.name %>&quot;? Config for this type will also be deleted.">
              <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete <%= ct.name %>"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</section>

<section class="card mt-4" id="backup">
  <div class="card-header"><h2 class="section-title"><i class="bi bi-database me-1"></i>Backup &amp; Restore</h2></div>
  <div class="card-body">
    <% if (_backupError) { %><div class="alert alert-danger py-2 small"><%= _backupError %></div><% } %>
    <div class="row g-4">
      <div class="col-lg-6">
        <h3 class="h6">Download backup</h3>
        <p class="small text-body-secondary">File SQLite <code>.db</code> — format sama dengan backup di Settings — berisi website ini saja: pengaturan (termasuk proxy dan cookie), page config, dan custom page type. Akun admin, API key, log, dan cache gambar tidak ikut.</p>
        <a href="/admin/websites/<%= w.id %>/backup" class="btn btn-outline-info"><i class="bi bi-download me-1"></i>Download Backup</a>
      </div>
      <div class="col-lg-6">
        <h3 class="h6">Restore</h3>
        <p class="small text-body-secondary">Upload backup website ini, atau backup lengkap dari Settings (website bernama <code><%= w.name %></code> yang diambil). Pengaturan, page config, dan custom page type website ini diganti; website lain tidak tersentuh. Database saat ini otomatis di-backup dulu (<code>.pre-restore</code>).</p>
        <form method="POST" action="/admin/websites/<%= w.id %>/restore" enctype="multipart/form-data" data-confirm="Restore &quot;<%= w.name %>&quot; dari backup? Pengaturan, page config, dan custom page type-nya saat ini akan diganti.">
          <div class="input-group">
            <input type="file" class="form-control" name="dbfile" accept=".db,.sqlite,.sqlite3" required aria-label="File backup">
            <button type="submit" class="btn btn-outline-warning"><i class="bi bi-upload me-1"></i>Restore</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="card border-danger-subtle mt-4 mb-2">
  <div class="card-header bg-danger-subtle text-danger-emphasis"><h2 class="section-title"><i class="bi bi-exclamation-triangle me-1"></i>Danger zone</h2></div>
  <div class="card-body d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
    <div class="flex-grow-1 small">Hapus website ini beserta semua page config dan custom page type-nya. Tidak bisa dibatalkan.</div>
    <form method="POST" action="/admin/websites/<%= w.id %>/delete" data-confirm="Delete website &quot;<%= w.name %>&quot; and all its configs?">
      <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete Website</button>
    </form>
  </div>
</section>
<% } %>

<script>
(function () {
  const toggle = document.getElementById('imageProxy');
  const group = document.getElementById('cacheMethodGroup');
  if (toggle && group) toggle.addEventListener('change', () => group.classList.toggle('d-none', !toggle.checked));
  <% if (_backupError || _restoreError) { %>
  // The backup forms sit at the bottom of a long page — bring the error into view
  const target = document.getElementById(<%- JSON.stringify(_backupError ? 'backup' : 'restore') %>);
  if (target) target.scrollIntoView({ block: 'start' });
  <% } %>
})();
</script>
