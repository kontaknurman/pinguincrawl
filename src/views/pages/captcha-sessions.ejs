<div class="page-header">
  <div>
    <h1>CAPTCHA Sessions</h1>
    <p class="page-subtitle">Ambil alih browser crawler untuk menyelesaikan CAPTCHA secara manual. <span id="wsStatus" class="badge text-bg-secondary">connecting…</span></p>
  </div>
  <div class="page-actions align-items-center">
    <select id="fpWebsite" class="form-select form-select-sm w-auto" title="Cek memakai UA / custom headers / proxy milik website ini" aria-label="Website untuk cek fingerprint">
      <option value="">(setelan global)</option>
      <% (typeof websites !== 'undefined' ? websites : []).forEach(w => { %>
        <option value="<%= w.name %>"><%= w.name %></option>
      <% }) %>
    </select>
    <button type="button" id="btnDiagnose" class="btn btn-sm btn-outline-info" title="Cek sinyal bot pada browser crawler (kenapa Cloudflare masih loop)">
      <i class="bi bi-activity me-1"></i>Cek Fingerprint
    </button>
  </div>
</div>

<% if (!settings.enabled) { %>
<div class="alert alert-warning d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
  <div class="flex-grow-1"><i class="bi bi-exclamation-triangle me-1"></i>Manual takeover <strong>nonaktif</strong> — crawler hanya menunggu Cloudflare secara pasif. Aktifkan di pengaturan di bawah.</div>
</div>
<% } %>

<!-- Settings (collapsed once takeover is enabled) -->
<section class="card mb-4">
  <div class="card-header p-0">
    <button class="btn w-100 text-start d-flex align-items-center gap-2 px-3 py-2 <%= settings.enabled ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#captchaSettings" aria-expanded="<%= settings.enabled ? 'false' : 'true' %>" aria-controls="captchaSettings">
      <i class="bi bi-gear"></i>
      <span class="section-title">Pengaturan</span>
      <% if (settings.enabled) { %><span class="badge text-bg-success">takeover aktif</span><% } else { %><span class="badge text-bg-warning">takeover nonaktif</span><% } %>
      <span class="small text-body-secondary d-none d-sm-inline">timeout <%= settings.timeoutSecs %> dtk<%= settings.notifyUrl ? ' · webhook aktif' : '' %></span>
      <i class="bi bi-chevron-down ms-auto"></i>
    </button>
  </div>
  <div id="captchaSettings" class="collapse <%= settings.enabled ? '' : 'show' %>">
    <div class="card-body">
      <form method="POST" action="/admin/captcha/settings" class="row g-3">
        <div class="col-12">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="manual_enabled" name="manual_enabled" <%= settings.enabled ? 'checked' : '' %>>
            <label class="form-check-label" for="manual_enabled">Enable manual takeover</label>
          </div>
          <small class="form-hint">Saat mati, crawler berperilaku seperti biasa (hanya menunggu Cloudflare secara pasif).</small>
        </div>
        <div class="col-sm-4 col-lg-2">
          <label class="form-label" for="timeout_secs">Timeout (detik)</label>
          <input type="number" class="form-control" id="timeout_secs" name="timeout_secs" min="30" max="1800" value="<%= settings.timeoutSecs %>" inputmode="numeric">
        </div>
        <div class="col-sm-8 col-lg-6">
          <label class="form-label" for="notify_url">Notify webhook URL <span class="text-body-secondary">(opsional)</span></label>
          <input type="url" class="form-control" id="notify_url" name="notify_url" placeholder="Slack/Discord/Telegram webhook" value="<%= settings.notifyUrl %>">
          <small class="form-hint">Slack/Discord menerima <code>{text}</code>; URL <code>api.telegram.org</code> juga butuh chat id.</small>
        </div>
        <div class="col-lg-4">
          <label class="form-label" for="telegram_chat_id">Telegram chat id <span class="text-body-secondary">(opsional)</span></label>
          <input type="text" class="form-control" id="telegram_chat_id" name="telegram_chat_id" placeholder="123456789" value="<%= settings.telegramChatId %>" inputmode="numeric">
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Settings</button>
        </div>
      </form>
    </div>
  </div>
</section>

<div class="row g-4">
  <!-- Session list -->
  <div class="col-lg-5 order-2 order-lg-1">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="section-title">Sessions <span id="waitingBadge" class="badge text-bg-warning ms-1 d-none">0 waiting</span></h2>
      <small class="text-body-secondary">auto-refresh</small>
    </div>
    <div id="sessionList" class="d-flex flex-column gap-2">
      <div class="text-body-secondary small">Belum ada sesi.</div>
    </div>
  </div>

  <!-- Live viewer -->
  <div class="col-lg-7 order-1 order-lg-2">
    <div class="card" id="viewerCard">
      <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span id="viewerTitle" class="text-truncate"><i class="bi bi-display me-1"></i>Live Viewer</span>
        <span class="d-flex align-items-center gap-2 flex-shrink-0">
          <span id="viewerCountdown" class="badge text-bg-secondary d-none"></span>
          <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnFullscreen" title="Layar penuh" aria-label="Layar penuh"><i class="bi bi-arrows-fullscreen"></i></button>
        </span>
      </div>
      <div class="card-body">
        <div id="viewerEmpty" class="text-body-secondary text-center py-5">
          <i class="bi bi-mouse2 d-block fs-1 mb-2"></i>
          Pilih sesi yang menunggu lalu klik <strong>Ambil Alih</strong> untuk mengendalikannya.
        </div>
        <div id="viewerPanel" class="d-none">
          <div class="alert alert-info py-1 px-2 small mb-2">
            Klik/tap layar untuk fokus, lalu klik &amp; ketik untuk menyelesaikan. Mouse, sentuhan, dan keyboard langsung diteruskan ke browser.
          </div>
          <div id="screenWrap" tabindex="0">
            <img id="screen" alt="live screencast" draggable="false">
            <div id="screenFocusHint">Klik untuk fokus keyboard</div>
          </div>
          <div class="input-group input-group-sm mt-2">
            <input type="text" class="form-control" id="typeText" placeholder="Ketik teks…" autocomplete="off" autocapitalize="none" spellcheck="false" aria-label="Teks untuk dikirim">
            <button class="btn btn-outline-secondary" type="button" id="btnSendText">Kirim</button>
            <button class="btn btn-outline-secondary" type="button" data-key="Backspace" title="Backspace" aria-label="Backspace"><i class="bi bi-backspace"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-key="Enter" title="Enter" aria-label="Enter"><i class="bi bi-arrow-return-left"></i></button>
          </div>
          <div class="d-flex gap-2 mt-2 flex-wrap align-items-center">
            <button id="btnSolved" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Selesai (Solved)</button>
            <button id="btnFailed" class="btn btn-sm btn-danger"><i class="bi bi-x-lg me-1"></i>Gagal (Fail)</button>
            <button id="btnDetach" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye-slash me-1"></i>Lepas (Detach)</button>
            <span class="ms-sm-auto small text-body-secondary text-break" id="viewerMeta"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const STATUS_BADGE = {
    running: 'text-bg-secondary',
    waiting_captcha: 'text-bg-warning',
    solving: 'text-bg-info',
    done: 'text-bg-success',
    failed: 'text-bg-danger',
  };
  const STATUS_LABEL = {
    running: 'running',
    waiting_captcha: 'waiting captcha',
    solving: 'solving',
    done: 'done',
    failed: 'failed',
  };

  const listEl = document.getElementById('sessionList');
  const waitingBadge = document.getElementById('waitingBadge');
  const wsStatus = document.getElementById('wsStatus');
  const viewerCard = document.getElementById('viewerCard');
  const viewerEmpty = document.getElementById('viewerEmpty');
  const viewerPanel = document.getElementById('viewerPanel');
  const viewerTitle = document.getElementById('viewerTitle');
  const viewerMeta = document.getElementById('viewerMeta');
  const viewerCountdown = document.getElementById('viewerCountdown');
  const btnFullscreen = document.getElementById('btnFullscreen');
  const screenWrap = document.getElementById('screenWrap');
  const screenImg = document.getElementById('screen');
  const focusHint = document.getElementById('screenFocusHint');

  let ws = null;
  let sessions = [];
  let activeId = null;         // session currently attached in the viewer
  let lastObjectUrl = null;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function fmtAgo(ts) {
    if (!ts) return '';
    const secs = Math.max(0, Math.round((Date.now() - ts) / 1000));
    if (secs < 60) return secs + 's ago';
    return Math.round(secs / 60) + 'm ago';
  }

  function send(obj) {
    if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(obj));
  }

  function setWsStatus(text, cls) {
    wsStatus.textContent = text;
    wsStatus.className = 'badge ' + cls;
  }

  function connect() {
    const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    ws = new WebSocket(`${proto}//${location.host}/admin/captcha/ws`);

    ws.onopen = () => setWsStatus('connected', 'text-bg-success');
    ws.onclose = () => {
      setWsStatus('disconnected — retrying', 'text-bg-danger');
      setTimeout(connect, 2000);
    };
    ws.onerror = () => { try { ws.close(); } catch (e) {} };

    ws.onmessage = (evt) => {
      let msg;
      try { msg = JSON.parse(evt.data); } catch (e) { return; }
      if (msg.type === 'sessions') {
        sessions = msg.sessions || [];
        renderList();
        syncViewer();
      } else if (msg.type === 'frame' && msg.id === activeId) {
        showFrame(msg.data);
      } else if (msg.type === 'error') {
        if (msg.id === activeId) { viewerMeta.textContent = 'Error: ' + msg.message; }
      }
    };
  }

  function showFrame(base64) {
    // Decode base64 JPEG into a blob URL (avoids giant data: URIs each frame)
    try {
      const bin = atob(base64);
      const len = bin.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
      const blob = new Blob([bytes], { type: 'image/jpeg' });
      const urlObj = URL.createObjectURL(blob);
      screenImg.src = urlObj;
      if (lastObjectUrl) URL.revokeObjectURL(lastObjectUrl);
      lastObjectUrl = urlObj;
    } catch (e) { /* ignore bad frame */ }
  }

  function renderList() {
    const waiting = sessions.filter(s => s.status === 'waiting_captcha' || s.status === 'solving').length;
    if (waiting > 0) {
      waitingBadge.textContent = waiting + ' waiting';
      waitingBadge.classList.remove('d-none');
    } else {
      waitingBadge.classList.add('d-none');
    }

    if (!sessions.length) {
      listEl.innerHTML = '<div class="text-body-secondary small">Belum ada sesi.</div>';
      return;
    }

    listEl.innerHTML = sessions.map(s => {
      const badge = STATUS_BADGE[s.status] || 'text-bg-secondary';
      const label = STATUS_LABEL[s.status] || s.status;
      const isActionable = s.status === 'waiting_captcha' || s.status === 'solving';
      const isActive = s.id === activeId;
      let timeInfo = '';
      if (isActionable && s.timeoutAt) {
        timeInfo = `<span class="text-warning-emphasis text-nowrap" data-countdown="${Number(s.timeoutAt)}">${fmtLeft(s.timeoutAt)}</span>`;
      } else if (s.status === 'running') {
        timeInfo = `<span class="text-body-secondary text-nowrap" data-ago="${Number(s.createdAt)}">${fmtAgo(s.createdAt)}</span>`;
      } else if (s.finishedAt) {
        timeInfo = `<span class="text-body-secondary text-nowrap" data-ago="${Number(s.finishedAt)}">${fmtAgo(s.finishedAt)}</span>`;
      }
      const captcha = s.captchaType ? `<span class="badge bg-body-secondary text-body border ms-1">${esc(s.captchaType)}</span>` : '';
      const viewers = s.viewers > 0 ? `<span class="badge text-bg-info ms-1"><i class="bi bi-eye"></i> ${s.viewers}</span>` : '';
      return `
        <div class="card ${isActive ? 'border-info' : ''} ${isActionable ? 'border-warning-subtle' : ''}">
          <div class="card-body py-2 px-3">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div class="min-w-0">
                <span class="badge ${badge}">${label}</span>
                ${captcha}${viewers}
                <div class="mt-1"><strong>${esc(s.website)}</strong> <span class="text-body-secondary">/ ${esc(s.pageType)}</span></div>
                <div class="text-body-secondary small text-truncate" title="${esc(s.url || '')}">${esc(s.url || '')}</div>
                ${s.captchaReason ? `<div class="text-body-secondary small">${esc(s.captchaReason)}</div>` : ''}
                ${s.finishReason ? `<div class="text-danger-emphasis small">${esc(s.finishReason)}</div>` : ''}
              </div>
              <div class="text-end small">${timeInfo}</div>
            </div>
            ${isActionable ? `
            <div class="mt-2 d-flex gap-1 flex-wrap">
              ${isActive
                ? `<button class="btn btn-sm btn-info" disabled><i class="bi bi-eye"></i> Controlling</button>`
                : `<button class="btn btn-sm btn-outline-info" data-attach="${s.id}"><i class="bi bi-mouse2 me-1"></i>Ambil Alih</button>`}
              <button class="btn btn-sm btn-outline-success" data-solved="${s.id}">Selesai</button>
              <button class="btn btn-sm btn-outline-danger" data-failed="${s.id}">Gagal</button>
            </div>` : ''}
          </div>
        </div>`;
    }).join('');
  }

  // One delegated handler: buttons are re-created whenever the session list changes
  listEl.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    if (b.dataset.attach) attach(b.dataset.attach);
    else if (b.dataset.solved) send({ type: 'solved', id: b.dataset.solved });
    else if (b.dataset.failed) send({ type: 'failed', id: b.dataset.failed });
  });

  function fmtLeft(ts) {
    return '⏳ ' + Math.max(0, Math.round((ts - Date.now()) / 1000)) + 's left';
  }

  // Countdowns tick in place — re-rendering the list every second would swallow taps
  function tick() {
    listEl.querySelectorAll('[data-countdown]').forEach((el) => { el.textContent = fmtLeft(Number(el.dataset.countdown)); });
    listEl.querySelectorAll('[data-ago]').forEach((el) => { el.textContent = fmtAgo(Number(el.dataset.ago)); });
    syncViewer();
  }

  function currentActive() {
    return sessions.find(s => s.id === activeId);
  }

  function syncViewer() {
    const s = currentActive();
    // Close viewer if the active session is gone or no longer controllable.
    // Send detach so the server frees its viewer entry (harmless if already gone).
    if (activeId && (!s || (s.status !== 'solving' && s.status !== 'waiting_captcha'))) {
      closeViewer(true);
      return;
    }
    if (s) {
      viewerTitle.innerHTML = `<i class="bi bi-display me-1"></i>${esc(s.website)} / ${esc(s.pageType)}`;
      viewerMeta.textContent = s.captchaType ? (s.captchaType + ' — ' + (s.captchaReason || '')) : '';
      if (s.timeoutAt) {
        const left = Math.max(0, Math.round((s.timeoutAt - Date.now()) / 1000));
        viewerCountdown.textContent = '⏳ ' + left + 's';
        viewerCountdown.classList.remove('d-none');
      } else {
        viewerCountdown.classList.add('d-none');
      }
    }
  }

  function attach(id) {
    if (activeId && activeId !== id) send({ type: 'detach', id: activeId });
    activeId = id;
    viewerEmpty.classList.add('d-none');
    viewerPanel.classList.remove('d-none');
    btnFullscreen.classList.remove('d-none');
    screenImg.style.touchAction = 'none'; // every touch goes to the remote browser
    screenImg.removeAttribute('src');
    send({ type: 'attach', id });
    renderList();
    syncViewer();
    screenWrap.focus({ preventScroll: true });
    // On phones the viewer sits above the list — bring it into view
    if (window.matchMedia('(max-width: 991.98px)').matches) viewerCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function closeViewer(sendDetach) {
    if (activeId && sendDetach) send({ type: 'detach', id: activeId });
    activeId = null;
    setFullscreen(false);
    viewerPanel.classList.add('d-none');
    viewerEmpty.classList.remove('d-none');
    viewerCountdown.classList.add('d-none');
    btnFullscreen.classList.add('d-none');
    screenImg.style.touchAction = '';
    if (lastObjectUrl) { URL.revokeObjectURL(lastObjectUrl); lastObjectUrl = null; }
    renderList();
  }

  function setFullscreen(on) {
    viewerCard.classList.toggle('is-fullscreen', on);
    document.body.classList.toggle('overflow-hidden', on);
    btnFullscreen.innerHTML = on ? '<i class="bi bi-fullscreen-exit"></i>' : '<i class="bi bi-arrows-fullscreen"></i>';
    btnFullscreen.title = on ? 'Keluar layar penuh' : 'Layar penuh';
  }
  btnFullscreen.addEventListener('click', () => setFullscreen(!viewerCard.classList.contains('is-fullscreen')));

  // ---- Input capture on the screencast image (mouse, touch and pen via pointer events) ----
  function norm(e) {
    const r = screenImg.getBoundingClientRect();
    const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    return { x, y };
  }
  function relayMouse(type, e) {
    if (!activeId) return;
    const p = norm(e);
    send({ type: 'input', id: activeId, event: { type, x: p.x, y: p.y, button: e.button < 0 ? 0 : e.button } });
  }

  let pressed = false;
  screenImg.addEventListener('pointerdown', (e) => {
    if (!activeId) return;
    e.preventDefault();
    screenWrap.focus({ preventScroll: true });
    try { screenImg.setPointerCapture(e.pointerId); } catch (err) { /* not capturable */ }
    pressed = true;
    relayMouse('down', e);
  });
  screenImg.addEventListener('pointerup', (e) => {
    if (!activeId) return;
    e.preventDefault();
    pressed = false;
    relayMouse('up', e);
  });
  // A cancelled touch (system gesture) must not leave the remote button held down
  screenImg.addEventListener('pointercancel', (e) => {
    if (activeId && pressed) relayMouse('up', e);
    pressed = false;
  });

  let lastMove = 0;
  screenImg.addEventListener('pointermove', (e) => {
    if (!activeId) return;
    const now = Date.now();
    if (now - lastMove < 45) return; // throttle
    lastMove = now;
    relayMouse('move', e);
  });
  screenImg.addEventListener('contextmenu', (e) => e.preventDefault());
  screenImg.addEventListener('wheel', (e) => {
    if (!activeId) return;
    e.preventDefault();
    const p = norm(e);
    send({ type: 'input', id: activeId, event: { type: 'wheel', x: p.x, y: p.y, deltaX: e.deltaX, deltaY: e.deltaY } });
  }, { passive: false });

  // Keyboard — only while the viewer is focused
  screenWrap.addEventListener('focus', () => { focusHint.style.display = 'none'; });
  screenWrap.addEventListener('blur', () => { if (activeId) focusHint.style.display = 'flex'; });
  screenWrap.addEventListener('keydown', (e) => {
    if (!activeId) return;
    // Let refresh / devtools through
    if (e.key === 'F5' || (e.ctrlKey && ['r', 'R'].includes(e.key))) return;
    e.preventDefault();
    send({ type: 'input', id: activeId, event: { type: 'key', key: e.key, code: e.code, keyCode: e.keyCode } });
  });

  // Phones have no physical keyboard for the focused screen — type into a box instead.
  // Characters go out one by one with a human-ish rhythm.
  const typeText = document.getElementById('typeText');
  function sendKey(key) {
    if (activeId) send({ type: 'input', id: activeId, event: { type: 'key', key } });
  }
  function sendText() {
    const chars = Array.from(typeText.value);
    typeText.value = '';
    let delay = 0;
    chars.forEach((ch) => {
      delay += 60 + Math.floor(Math.random() * 60);
      setTimeout(() => sendKey(ch), delay);
    });
  }
  document.getElementById('btnSendText').addEventListener('click', sendText);
  typeText.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); sendText(); } });
  viewerPanel.querySelectorAll('[data-key]').forEach((b) => b.addEventListener('click', () => sendKey(b.dataset.key)));

  // Fingerprint check — open the report for the selected website (or global settings)
  const btnDiag = document.getElementById('btnDiagnose');
  if (btnDiag) btnDiag.addEventListener('click', () => {
    const w = document.getElementById('fpWebsite').value;
    window.open('/admin/captcha/diagnose' + (w ? '?website=' + encodeURIComponent(w) : ''), '_blank');
  });

  document.getElementById('btnSolved').addEventListener('click', () => { if (activeId) send({ type: 'solved', id: activeId }); });
  document.getElementById('btnFailed').addEventListener('click', () => { if (activeId) send({ type: 'failed', id: activeId }); });
  document.getElementById('btnDetach').addEventListener('click', () => closeViewer(true));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && viewerCard.classList.contains('is-fullscreen') && document.activeElement !== screenWrap) setFullscreen(false);
  });

  // Tick countdowns once per second (uses cached session list, no server round-trip)
  setInterval(tick, 1000);

  connect();
})();
</script>
