<div class="page-header">
  <div>
    <h1>Settings</h1>
    <p class="page-subtitle">Browser crawler, akses API, keamanan akun kamu, dan backup database.</p>
  </div>
</div>

<nav class="scroll-x mb-4" aria-label="Bagian settings">
  <a class="btn btn-sm btn-outline-secondary" href="#crawl"><i class="bi bi-window-stack me-1"></i>Crawl &amp; Browser</a>
  <a class="btn btn-sm btn-outline-secondary" href="#api"><i class="bi bi-key me-1"></i>Akses API</a>
  <a class="btn btn-sm btn-outline-secondary" href="#proxy"><i class="bi bi-hdd-network me-1"></i>Proxy</a>
  <a class="btn btn-sm btn-outline-secondary" href="#wireguard"><i class="bi bi-shield-shaded me-1"></i>WireGuard</a>
  <a class="btn btn-sm btn-outline-secondary" href="#security"><i class="bi bi-shield-lock me-1"></i>Keamanan</a>
  <a class="btn btn-sm btn-outline-secondary" href="#backup"><i class="bi bi-database me-1"></i>Backup &amp; Restore</a>
</nav>

<div class="row g-4">
  <!-- Crawl & browser -->
  <div class="col-xl-6">
    <section class="card h-100" id="crawl">
      <div class="card-header"><h2 class="section-title"><i class="bi bi-window-stack me-1"></i>Crawl &amp; Browser</h2></div>
      <div class="card-body">
        <form method="POST" action="/admin/crawl-settings">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="max_browsers">Max concurrent browsers</label>
              <input type="number" class="form-control" id="max_browsers" name="max_browsers" value="<%= maxBrowsers %>" min="1" max="50" inputmode="numeric">
              <small class="form-hint">Jumlah browser Lightpanda yang boleh jalan bersamaan (1–50). Tiap crawl memakai satu proses (±25 MB), jauh lebih ringan dari Chrome — tapi terlalu banyak tetap bisa menyebabkan OOM.</small>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="retry_count">Retry count</label>
              <input type="number" class="form-control" id="retry_count" name="retry_count" value="<%= retryCount %>" min="0" max="5" inputmode="numeric">
              <small class="form-hint">0 = mati, maksimal 5.</small>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="retry_delay">Retry delay (ms)</label>
              <input type="number" class="form-control" id="retry_delay" name="retry_delay" value="<%= retryDelay %>" min="500" max="30000" step="500" inputmode="numeric">
            </div>
            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="challenge_detection" name="challenge_detection" <%= challengeDetection ? 'checked' : '' %>>
                <label class="form-check-label" for="challenge_detection">Deteksi halaman CAPTCHA / challenge</label>
              </div>
              <small class="form-hint">Lightpanda tidak bisa melewati Cloudflare/CAPTCHA. Saat aktif, crawl yang mendapat halaman challenge langsung gagal dengan pesan jelas (tanpa retry). Matikan hanya kalau halaman normal salah terdeteksi.</small>
            </div>
          </div>
          <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check-lg me-1"></i>Save Crawl Settings</button>
        </form>

        <hr class="my-4">
        <h3 class="h6">Browser</h3>
        <% if (lightpanda.executable) { %>
          <p class="small text-body-secondary mb-2"><span class="badge text-bg-success me-1">Lightpanda<%= lightpanda.version ? ' ' + lightpanda.version : '' %></span><code class="text-break-all"><%= lightpanda.executable %></code></p>
        <% } else { %>
          <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-octagon me-1"></i>Lightpanda tidak ditemukan — crawl dengan JS rendering akan gagal. Lihat README untuk instalasi, atau set <code>LIGHTPANDA_EXECUTABLE_PATH</code>.</div>
        <% } %>
        <div class="input-group input-group-sm">
          <select id="checkWebsite" class="form-select" aria-label="Website untuk dicek">
            <option value="">(tanpa website)</option>
            <% websites.forEach(w => { %>
              <option value="<%= w.name %>"><%= w.name %></option>
            <% }) %>
          </select>
          <button type="button" id="btnBrowserCheck" class="btn btn-outline-info"><i class="bi bi-activity me-1"></i>Cek Lightpanda</button>
        </div>
        <small class="form-hint">Menjalankan browser crawler lalu melaporkan hasilnya (JSON, tab baru). Pilih website untuk sekalian membuka base URL-nya dengan proxy, User-Agent, dan header milik website itu — termasuk apakah situsnya memasang challenge.</small>
      </div>
    </section>
  </div>

  <!-- API access -->
  <div class="col-xl-6">
    <section class="card h-100" id="api">
      <div class="card-header"><h2 class="section-title"><i class="bi bi-key me-1"></i>Akses API</h2></div>
      <div class="card-body">
        <form method="POST" action="/admin/api-key" class="mb-4">
          <label class="form-label" for="api_key">API key</label>
          <div class="input-group">
            <input type="text" class="form-control font-monospace" id="api_key" name="api_key" value="<%= apiKey %>" placeholder="Kosong = akses terbuka" autocomplete="off" spellcheck="false">
            <button class="btn btn-outline-secondary" type="button" id="btnGenKey" title="Buat key acak"><i class="bi bi-shuffle"></i><span class="d-none d-sm-inline ms-1">Generate</span></button>
            <button class="btn btn-outline-secondary" type="button" data-copy-target="#api_key" title="Copy" aria-label="Copy API key"><i class="bi bi-clipboard"></i></button>
          </div>
          <small class="form-hint">Melindungi semua endpoint <code>/api/*</code>. Kirim lewat <code>?api_key=…</code> atau header <code>X-API-Key</code>. Kosongkan untuk akses terbuka.</small>
          <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check-lg me-1"></i>Save API Key</button>
        </form>

        <form method="POST" action="/admin/ip-whitelist">
          <label class="form-label" for="ip_whitelist">IP whitelist</label>
          <textarea class="form-control font-monospace" id="ip_whitelist" name="ip_whitelist" rows="2" placeholder="mis. 192.168.1.100, 10.0.0.1"><%= ipWhitelist %></textarea>
          <small class="form-hint">
            Batasi akses API ke IP tertentu, pisahkan dengan koma. Kosong = semua IP boleh.
            <% if (clientIp) { %>IP kamu saat ini: <code><%= clientIp %></code> <a href="#" data-copy="<%= clientIp %>" class="ms-1">copy</a>.<% } %>
          </small>
          <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check-lg me-1"></i>Save IP Whitelist</button>
        </form>
      </div>
    </section>
  </div>

  <!-- Proxies (HTTP/HTTPS/SOCKS) every website can pick from, and the global default -->
  <div class="col-12">
    <section class="card" id="proxy">
      <div class="card-header d-flex flex-wrap gap-2 align-items-center">
        <h2 class="section-title me-auto"><i class="bi bi-hdd-network me-1"></i>Proxy</h2>
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= px.entries.length %> proxy · <%= wg.configs.length %> WireGuard</span>
      </div>
      <div class="card-body">
        <% if (proxyError) { %><div class="alert alert-danger py-2 small"><%= proxyError %></div><% } %>
        <p class="small text-body-secondary">Semua proxy disimpan di sini sekali, lalu dipilih per website lewat menu <em>Proxy / VPN</em> di form website — bersama config <a href="#wireguard">WireGuard</a> di bawah. Ganti alamat atau login proxy cukup di sini; semua website yang memakainya ikut.</p>

        <div class="row g-4">
          <div class="col-lg-5">
            <h3 class="h6">Default global</h3>
            <form method="POST" action="/admin/proxy-default" id="proxyDefault">
              <%- include('../partials/proxy-picker', { picker: px.picker }) %>
              <small class="form-hint d-block">
                Dipakai website yang memilih <em>Default global</em>
                <% if (px.defaultUsers.length) { %>— sekarang: <%= px.defaultUsers.length > 6 ? px.defaultUsers.slice(0, 6).join(', ') + ' +' + (px.defaultUsers.length - 6) : px.defaultUsers.join(', ') %><% } else { %>— belum ada<% } %>.
                Website baru otomatis memakai default ini.
              </small>
              <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check-lg me-1"></i>Save Default</button>
            </form>
          </div>

          <div class="col-lg-7">
            <h3 class="h6">Tambah proxy</h3>
            <form method="POST" action="/admin/proxies" id="proxyAdd">
              <div class="mb-2">
                <label class="form-label small" for="proxy_urls">Alamat — satu per baris <span class="text-body-secondary">(boleh banyak sekaligus)</span></label>
                <textarea class="form-control font-monospace" id="proxy_urls" name="urls" rows="4" placeholder="http://user:pass@host:port&#10;socks5://user:pass@host:port&#10;host:port:user:pass" autocapitalize="none" spellcheck="false" autocomplete="off" required><%= proxyForm.urls || '' %></textarea>
                <small class="form-hint">Format: <code>http://user:pass@host:port</code>, <code>https://…</code>, <code>socks5://…</code>, <code>socks4://…</code>, <code>host:port</code> atau <code>host:port:user:pass</code>.</small>
              </div>
              <div class="mb-2">
                <label class="form-label small" for="proxy_name">Nama <span class="text-body-secondary">(opsional)</span></label>
                <input type="text" class="form-control font-monospace" id="proxy_name" name="name" value="<%= proxyForm.name || '' %>" placeholder="mis. sg-residential" autocapitalize="none" spellcheck="false" autocomplete="off">
                <small class="form-hint">Kosong = nama dari host-port (mis. <code>1.2.3.4-8080</code>). Untuk beberapa baris, nama ini jadi awalan: <code>nama-1</code>, <code>nama-2</code>, …</small>
              </div>
              <button type="submit" class="btn btn-primary mt-2"><i class="bi bi-plus-lg me-1"></i>Add Proxy</button>
            </form>
          </div>
        </div>

        <hr class="my-4">
        <h3 class="h6">Daftar proxy</h3>
        <% if (!px.entries.length) { %>
          <p class="small text-body-secondary mb-0">Belum ada proxy. Tambahkan di atas, lalu pilih di form website atau jadikan default global.</p>
        <% } else { %>
        <div class="list-group" id="proxyList">
          <% px.entries.forEach(e => { const h = e.health; %>
          <div class="list-group-item py-3" data-proxy="<%= e.name %>">
            <div class="d-flex flex-column flex-md-row gap-2 gap-md-3 align-items-md-center">
              <div class="min-w-0 flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <span class="fw-semibold font-monospace text-break"><%= e.name %></span>
                  <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= e.kind %></span>
                  <% if (e.isDefault) { %><span class="badge text-bg-primary">default</span><% } %>
                  <% if (!e.ok) { %><span class="badge text-bg-danger" title="<%= e.error %>">alamat tidak valid</span>
                  <% } else if (h.coolingDown) { %><span class="badge text-bg-danger" title="<%= h.error || '' %>">gagal · istirahat <%= Math.ceil(h.cooldownLeftMs / 60000) %> mnt</span>
                  <% } else if (h.okAt) { %><span class="badge text-bg-success">OK</span>
                  <% } else if (h.failedAt) { %><span class="badge text-bg-warning" title="<%= h.error || '' %>">pernah gagal</span>
                  <% } else { %><span class="badge bg-secondary-subtle text-secondary-emphasis">belum dipakai</span><% } %>
                </div>
                <div class="small text-body-secondary mt-1 text-break"><code><%= e.display %></code><% if (e.login) { %> · login <code><%= e.login %></code><% } %></div>
                <div class="small text-body-secondary">Dipakai: <%= e.usedBy.length ? e.usedBy.join(', ') : '—' %></div>
                <% if (h.error && (h.coolingDown || !h.okAt || h.failedAt > h.okAt)) { %><div class="small text-danger-emphasis text-break"><i class="bi bi-exclamation-octagon me-1"></i><%= h.error %></div><% } %>
              </div>
              <div class="d-flex gap-2 flex-shrink-0">
                <form method="POST" action="/admin/proxies/<%= e.id %>/test" data-busy><button type="submit" class="btn btn-sm btn-outline-info" title="Buka <%= px.testUrl %> lewat proxy ini"><i class="bi bi-activity me-1"></i>Test</button></form>
                <a href="/admin/proxies/<%= e.id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
                <form method="POST" action="/admin/proxies/<%= e.id %>/delete" data-confirm="Hapus proxy &quot;<%= e.name %>&quot;?"><button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus" aria-label="Hapus <%= e.name %>"><i class="bi bi-trash"></i></button></form>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <small class="form-hint d-block mt-2">Status sejak server terakhir start — dari crawl, <em>Cek Lightpanda</em> per website, dan tombol Test (membuka <code><%= px.testUrl %></code> lewat proxy, persis seperti crawl).</small>
        <% } %>
      </div>
    </section>
  </div>

  <!-- WireGuard configs: the second kind of website proxy -->
  <div class="col-12">
    <section class="card" id="wireguard">
      <div class="card-header d-flex flex-wrap gap-2 align-items-center">
        <h2 class="section-title me-auto"><i class="bi bi-shield-shaded me-1"></i>WireGuard (VPN)</h2>
        <% if (wg.executable) { %><span class="badge text-bg-success" title="<%= wg.executable %>">wireproxy<%= wg.version ? ' ' + wg.version : '' %></span><% } %>
      </div>
      <div class="card-body">
        <% if (!wg.executable) { %>
          <div class="alert alert-warning py-2 small"><i class="bi bi-exclamation-triangle me-1"></i><code>wireproxy</code> tidak ditemukan — config tetap bisa disimpan, tapi website yang memakai WireGuard gagal crawl sampai wireproxy terpasang (lihat README) atau <code>WIREPROXY_EXECUTABLE_PATH</code> diset.</div>
        <% } %>
        <% if (wgError) { %><div class="alert alert-danger py-2 small"><%= wgError %></div><% } %>
        <p class="small text-body-secondary">Config WireGuard dari penyedia VPN (file <code>.conf</code>). Pilih config di menu <em>Proxy / VPN</em> form website, atau jadikan <a href="#proxy">default global</a> — lebih dari satu dirotasi seperti proxy, dan boleh dicampur dengan proxy biasa. Tiap config jalan sebagai satu proses kecil (±12 MB) hanya saat dipakai, dipakai bersama semua website, dan berhenti sendiri setelah <%= wg.idleMinutes %> menit tidak dipakai. Tidak butuh root atau NET_ADMIN.</p>

        <% if (wg.configs.length) { %>
        <div class="list-group mb-4" id="wgList">
          <% wg.configs.forEach(c => { %>
          <div class="list-group-item py-3" data-wg="<%= c.name %>">
            <div class="d-flex flex-column flex-md-row gap-2 gap-md-3 align-items-md-center">
              <div class="min-w-0 flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <span class="fw-semibold font-monospace text-break"><%= c.name %></span>
                  <% if (!c.ok) { %><span class="badge text-bg-danger">config rusak</span>
                  <% } else if (c.runtime) { %><span class="badge text-bg-success">berjalan<%= c.runtime.active ? ' · ' + c.runtime.active + ' crawl' : '' %></span>
                  <% } else { %><span class="badge bg-secondary-subtle text-secondary-emphasis">tidak berjalan</span><% } %>
                </div>
                <% if (c.ok) { %>
                  <div class="small text-body-secondary mt-1 text-break">Endpoint <code><%= c.endpoint %></code> · Address <code><%= c.address %></code> · DNS <%= c.dns ? c.dns : 'bawaan' %><% if (c.peers > 1) { %> · <%= c.peers %> peer<% } %></div>
                <% } else { %>
                  <div class="small text-danger mt-1"><%= c.error %></div>
                <% } %>
                <div class="small text-body-secondary">
                  Dipakai: <%= c.usedBy.length ? c.usedBy.join(', ') : '—' %>
                  <% if (c.runtime && c.runtime.handshakeAt) { %>· handshake terakhir <time data-utc="<%= c.runtime.handshakeAt * 1000 %>" data-relative></time><% } %>
                </div>
                <% c.warnings.forEach(note => { %><div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i><%= note %></div><% }) %>
              </div>
              <div class="d-flex gap-2 flex-shrink-0">
                <form method="POST" action="/admin/wireguard/<%= c.id %>/test" data-busy><button type="submit" class="btn btn-sm btn-outline-info"><i class="bi bi-activity me-1"></i>Test</button></form>
                <a href="/admin/wireguard/<%= c.id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
                <form method="POST" action="/admin/wireguard/<%= c.id %>/delete" data-confirm="Hapus config WireGuard &quot;<%= c.name %>&quot;?"><button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus" aria-label="Hapus <%= c.name %>"><i class="bi bi-trash"></i></button></form>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>

        <h3 class="h6">Tambah config</h3>
        <form method="POST" action="/admin/wireguard" enctype="multipart/form-data" id="wgAdd">
          <div class="row g-3">
            <div class="col-lg-6">
              <label class="form-label small" for="wg_files">Upload file <code>.conf</code> <span class="text-body-secondary">(boleh banyak sekaligus — nama config = nama file)</span></label>
              <input type="file" class="form-control" id="wg_files" name="files" accept=".conf,text/plain" multiple>
            </div>
            <div class="col-lg-6">
              <label class="form-label small" for="wg_name">Atau tempel config — beri nama</label>
              <input type="text" class="form-control font-monospace" id="wg_name" name="name" value="<%= wgForm.name || '' %>" placeholder="mis. vpn-sg-1" autocapitalize="none" spellcheck="false" autocomplete="off">
            </div>
            <div class="col-12">
              <textarea class="form-control font-monospace" id="wg_config" name="config" rows="7" spellcheck="false" autocomplete="off" aria-label="Isi config WireGuard" placeholder="[Interface]&#10;PrivateKey = …&#10;Address = 10.64.0.2/32&#10;DNS = 10.64.0.1&#10;&#10;[Peer]&#10;PublicKey = …&#10;Endpoint = vpn.example.com:51820&#10;AllowedIPs = 0.0.0.0/0"><%= wgForm.config || '' %></textarea>
              <small class="form-hint">Format wg-quick biasa. <code>PostUp</code>/<code>PreDown</code> diabaikan (tidak ada perintah yang dijalankan). Tanpa <code>DNS</code>, dipakai 1.1.1.1 dan 9.9.9.9 — tetap lewat tunnel. Jangan pakai config yang sama di perangkat lain bersamaan — server VPN akan bingung dan koneksi tersendat.</small>
            </div>
          </div>
          <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-plus-lg me-1"></i>Add Config</button>
        </form>
      </div>
    </section>
  </div>

  <!-- Security: the signed-in admin's own account -->
  <div class="col-12">
    <section class="card" id="security">
      <div class="card-header d-flex flex-wrap gap-2 align-items-center">
        <h2 class="section-title me-auto"><i class="bi bi-shield-lock me-1"></i>Keamanan akun <code><%= username %></code></h2>
        <a href="/admin/users" class="btn btn-sm btn-outline-secondary"><i class="bi bi-people me-1"></i>Kelola admin lain</a>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-lg-6">
            <h3 class="h6">Change password</h3>
            <% if (pwError) { %><div class="alert alert-danger py-2 small"><%= pwError %></div><% } %>
            <form method="POST" action="/admin/change-password">
              <!-- Lets password managers store the new password under the right username -->
              <input type="text" name="username" value="<%= username %>" autocomplete="username" hidden>
              <div class="mb-2">
                <label class="form-label small" for="current_password">Current password</label>
                <div class="input-group">
                  <input type="password" class="form-control" id="current_password" name="current_password" required autocomplete="current-password">
                  <button class="btn btn-outline-secondary" type="button" data-toggle-password="#current_password" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button>
                </div>
              </div>
              <div class="row g-2 mb-2">
                <div class="col-sm-6">
                  <label class="form-label small" for="new_password">New password</label>
                  <input type="password" class="form-control" id="new_password" name="new_password" required minlength="<%= minPassword %>" maxlength="200" autocomplete="new-password">
                </div>
                <div class="col-sm-6">
                  <label class="form-label small" for="confirm_password">Confirm password</label>
                  <input type="password" class="form-control" id="confirm_password" name="confirm_password" required minlength="<%= minPassword %>" maxlength="200" autocomplete="new-password">
                </div>
              </div>
              <small class="form-hint d-block mb-3">Minimal <%= minPassword %> karakter. Perangkat lain yang login dengan akun ini otomatis keluar.</small>
              <button type="submit" class="btn btn-warning"><i class="bi bi-key me-1"></i>Change Password</button>
            </form>
          </div>

          <div class="col-lg-6">
            <h3 class="h6">Two-factor auth (2FA)</h3>
            <% if (totpError) { %><div class="alert alert-danger py-2 small"><%= totpError %></div><% } %>
            <% if (totpEnabled) { %>
              <p class="small text-body-secondary"><span class="badge text-bg-success me-1">Aktif</span>Kode Google Authenticator diminta setiap kamu login.</p>
              <form method="POST" action="/admin/2fa/disable" data-confirm="Matikan 2FA? Login tidak lagi meminta kode authenticator.">
                <div class="input-group mb-2">
                  <input type="password" class="form-control" name="current_password" placeholder="Password untuk mematikan" required autocomplete="current-password" aria-label="Password">
                  <button type="submit" class="btn btn-outline-danger">Disable 2FA</button>
                </div>
              </form>
            <% } else { %>
              <p class="small text-body-secondary"><span class="badge text-bg-secondary me-1">Nonaktif</span>Tambahkan Google Authenticator (atau aplikasi TOTP lain) untuk keamanan ekstra.</p>
              <a href="/admin/2fa/setup" class="btn btn-outline-info"><i class="bi bi-shield-lock me-1"></i>Setup 2FA</a>
            <% } %>

            <hr class="my-4">
            <h3 class="h6">Sesi login</h3>
            <p class="small text-body-secondary">Keluarkan semua perangkat yang sedang login dengan akun ini (termasuk perangkat ini). Admin lain tidak ikut keluar.</p>
            <form method="POST" action="/admin/logout-all" data-confirm="Logout dari SEMUA perangkat? Kamu akan diarahkan ke halaman login.">
              <button type="submit" class="btn btn-outline-warning"><i class="bi bi-box-arrow-right me-1"></i>Logout All Devices</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Backup & restore -->
  <div class="col-12">
    <section class="card" id="backup">
      <div class="card-header"><h2 class="section-title"><i class="bi bi-database me-1"></i>Backup &amp; Restore</h2></div>
      <div class="card-body">
        <% if (backupError) { %><div class="alert alert-danger py-2 small"><%= backupError %></div><% } %>
        <div class="row g-4">
          <div class="col-lg-6">
            <h3 class="h6">Download backup</h3>
            <p class="small text-body-secondary">File SQLite berisi semua website, page config, settings, akun admin (hash password + secret 2FA), dan config WireGuard (termasuk private key) — simpan di tempat aman. Untuk satu website saja: buka halaman website itu → <em>Backup &amp; Restore</em> (format file sama).</p>
            <a href="/admin/backup" class="btn btn-outline-info"><i class="bi bi-download me-1"></i>Download Backup</a>
          </div>
          <div class="col-lg-6">
            <h3 class="h6">Restore</h3>
            <p class="small text-body-secondary">Upload file backup <code>.db</code>. Database saat ini otomatis di-backup dulu (<code>.pre-restore</code>). Akun admin ikut diganti dengan isi backup — setelahnya login dengan akun dari backup itu (backup crawlkomik / versi lama: username <code>admin</code> + password lamanya). Backup satu website di-restore dari halaman website-nya, bukan di sini.</p>
            <form method="POST" action="/admin/restore" enctype="multipart/form-data" data-confirm="Restore database? Data saat ini akan diganti.">
              <div class="input-group">
                <input type="file" class="form-control" name="dbfile" accept=".db,.sqlite,.sqlite3" required aria-label="File backup">
                <button type="submit" class="btn btn-outline-warning"><i class="bi bi-upload me-1"></i>Restore</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
(function () {
  const gen = document.getElementById('btnGenKey');
  if (gen) gen.addEventListener('click', () => {
    const bytes = new Uint8Array(24);
    crypto.getRandomValues(bytes);
    const input = document.getElementById('api_key');
    input.value = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    input.focus();
    if (window.ck) ck.toast('Key baru dibuat — klik Save API Key untuk menyimpan', 'info');
  });
  const btnCheck = document.getElementById('btnBrowserCheck');
  if (btnCheck) btnCheck.addEventListener('click', () => {
    const w = document.getElementById('checkWebsite').value;
    window.open('/admin/browser-check' + (w ? '?website=' + encodeURIComponent(w) : ''), '_blank');
  });
  <% if (focusSection) { %>
  const target = document.getElementById(<%- JSON.stringify(focusSection) %>);
  if (target) target.scrollIntoView({ block: 'start' });
  <% } %>
})();
</script>
