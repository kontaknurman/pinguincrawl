# Copy to .env — docker compose reads it automatically.

# Port the app listens on, inside the container and on the host: 6000 means 6000:6000
PORT=3000

# Password of the first admin (username "admin"), min. 8 characters. Only read on the very
# first start, while the database has no admin yet. Empty: the first login is admin/admin
# and has to choose a new password right away.
ADMIN_PASSWORD=

# 1 only when nginx/Caddy/Traefik sits in front of the app: the login brute-force brake
# then sees each visitor's IP instead of the proxy's. Never set it without such a proxy.
TRUST_PROXY=
